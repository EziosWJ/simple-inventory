# Host-integrated deployment using the PostgreSQL already attached to 1panel-network.
INVENTORY_PROJECT=simple-inventory
INVENTORY_RELEASE=replace-with-tested-release
INVENTORY_IMAGE_PREFIX=simple-inventory
APP_DOCKER_NETWORK=1panel-network
TRUSTED_PROXY_IP=172.18.0.1
CONFIG_FILE=/opt/simple-inventory/config/config.prod.yaml
UPLOADS_DIR=/opt/simple-inventory/data/uploads
API_PORT=18080
