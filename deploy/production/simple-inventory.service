[Unit]
Description=Simple Inventory Docker Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/simple-inventory
ExecStartPre=/usr/bin/docker compose --env-file /opt/simple-inventory/.env -f /opt/simple-inventory/compose.yaml config --quiet
ExecStart=/usr/bin/docker compose --env-file /opt/simple-inventory/.env -f /opt/simple-inventory/compose.yaml up --remove-orphans api
ExecStop=/usr/bin/docker compose --env-file /opt/simple-inventory/.env -f /opt/simple-inventory/compose.yaml down --timeout 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
