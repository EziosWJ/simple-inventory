# Copy to private .env, chmod 600, replace every placeholder before starting.
INVENTORY_PROJECT=simple-inventory
INVENTORY_RELEASE=replace-with-tested-release
INVENTORY_IMAGE_PREFIX=simple-inventory
DOMAIN=inventory.example.com
# Match the exact browser origin, including a non-default HTTPS port if used.
PUBLIC_ORIGIN=https://inventory.example.com
ACME_EMAIL=operator@example.com
POSTGRES_DB=simple_inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-with-generated-password
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_SUBNET=172.30.15.0/24
PROXY_IP=172.30.15.3
DB_IP=172.30.15.2
API_IP=172.30.15.4
# Exact tested image digests; major 17 pg_dump/pg_restore must match.
POSTGRES_IMAGE=postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
CADDY_IMAGE=caddy:2-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
